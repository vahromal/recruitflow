# Development environment (local, NOT for production). Copy to .env and edit.
ENVIRONMENT=dev
DEBUG=true

# PostgreSQL (docker-compose dev overrides host to "db")
POSTGRES_USER=recruitflow
POSTGRES_PASSWORD=recruitflow_dev_password
POSTGRES_DB=recruitflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT: generate with `openssl rand -hex 32`
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef0123456789abcdef

# CORS: frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Storage: local = Docker volume; s3 = S3-compatible (future)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=10

# Login rate limit
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_SECONDS=300
