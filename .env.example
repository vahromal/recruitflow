# RecruitFlow environment template. Copy to .env and fill in:
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Database ---
POSTGRES_USER=recruitflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=recruitflow

# --- Application ---
# JWT secret: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-openssl-rand-hex-32

# Your domain, comma-separated (used by CORS):
CORS_ORIGINS=https://example.com,https://www.example.com

# --- Domain for Caddy (HTTPS) ---
DOMAIN=example.com
EMAIL=admin@example.com

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
