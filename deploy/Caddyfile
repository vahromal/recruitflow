# RecruitFlow reverse proxy: automatic HTTPS via Let's Encrypt
# Replace example.com with your real domain (or use the ${DOMAIN} env below).
{
	email {$EMAIL}
}

{$DOMAIN} {
	encode gzip

	# API -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Health check passthrough
	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else -> static frontend
	handle {
		reverse_proxy frontend:80
	}

	# security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 15MB
	}

	log {
		output stdout
		format json
	}
}
